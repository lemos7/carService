{
  "name": "garagem-em-dia-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --dev-client --localhost --port 8081 --scheme garagememdia",
    "start:docker": "expo start --dev-client --lan --port 8081 --scheme garagememdia",
    "android": "expo run:android",
    "android:build": "expo run:android --no-bundler",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export": "expo export --platform android --platform ios"
  },
  "dependencies": {
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
