FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Maintenance/CarCare.Maintenance.Api/CarCare.Maintenance.Api.csproj -c Release -o /app/publish --no-self-contained
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
RUN mkdir -p /app/data /app/documents
EXPOSE 8080
ENTRYPOINT ["dotnet","CarCare.Maintenance.Api.dll"]
