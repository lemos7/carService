# Do not log query strings: password reset links contain short-lived tokens.
log_format safe '$remote_addr $request_method $uri $status $body_bytes_sent';
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_status 429;
server_tokens off;
server {
  listen 80;
  server_name ${SERVER_NAME};
  access_log /var/log/nginx/access.log safe;
  return 308 https://${SERVER_NAME}$request_uri;
}
server {
  listen 443 ssl;
  server_name ${SERVER_NAME};
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 11m;
  access_log /var/log/nginx/access.log safe;
  # Nginx error messages can contain the original URI; do not log request-level errors.
  error_log /var/log/nginx/error.log crit;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
  location ^~ /internal/ { return 404; }
  location = /health { return 404; }
  location ~* ^/api/auth/(login|register|forgot-password|reset-password)/?$ {
    client_max_body_size 16k;
    limit_req zone=auth burst=5 nodelay;
    proxy_pass http://identity-api:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For "";
  }
  location /api/auth/ { proxy_pass http://identity-api:8080; proxy_set_header Host $host; }
  location /api/vehicles/ { proxy_pass http://vehicles-api:8080; proxy_set_header Host $host; }
  location /api/maintenance/ { proxy_pass http://maintenance-api:8080; proxy_set_header Host $host; }
  location /uploads/ { proxy_pass http://vehicles-api:8080; proxy_set_header Host $host; }
  location / { try_files $uri $uri/ /index.html; }
}
